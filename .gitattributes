# Normalize line endings: Git stores text as LF, checks out native to the OS.
# This makes the repo behave the same regardless of each machine's settings.
* text=auto

# Keep these as LF everywhere (scripts/config that tools may run cross-platform)
*.py    text eol=lf
*.sh    text eol=lf
*.md    text
*.csv   text
*.json  text
*.yml   text
*.yaml  text

# Treat these as binary — never convert
*.png   binary
*.jpg   binary
*.xlsx  binary
*.db    binary
*.sqlite binary
